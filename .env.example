# 本机开发用的环境变量模板（对应 docker-compose.yml）
#
# 用法：
#   cp .env.example .env
#   # 填好下面的「必填」项
#   docker compose up -d
#
# 远程服务器部署用的是另一套：.env.prod.example + docker-compose.prod.yml。
#
# ============================================================
# 一条规则：不需要的项请保持注释状态（前面的 # 不要删），
# **不要写成 KEY= 留空**。
#
# 留空会往容器里注入空字符串，而 Hindsight 读取环境变量的方式分两种，
# 后果不同——
#   - 字符串类键（MODEL / BASE_URL / API_KEY）：空串等同于未设置，无害；
#   - PROVIDER：空串会覆盖掉默认值 openai，得到一个非法的空 provider；
#   - 数值类键（RETAIN_MAX_COMPLETION_TOKENS / MODEL_INIT_TIMEOUT）：
#     空串会让容器在 float()/int() 解析时直接抛 ValueError 退出，
#     **是崩溃，不是回落默认值**。
# ============================================================

# ============ Hindsight 鉴权（必填）============
# dsh 和内置控制台共用这个 token 访问 Hindsight API，是唯一的存放位置：
# coding-agents 插件通过 HINDSIGHT_API_TOKEN 环境变量读它，不再有配置文件副本。
# 本机版只绑回环（9999 和 3080 都是 127.0.0.1），所以填什么都能跑，
# 但别用 123456 这种值——同一台机器上的任何进程都能碰到这两个端口。
#   生成：openssl rand -hex 32
HINDSIGHT_API_TOKEN=

# ============ LLM（必填，缺 API_KEY 容器会在启动期崩溃）============
# provider 可选值：openai / anthropic / gemini / groq / deepseek / zai / minimax /
#   ollama / lmstudio / bedrock / vertexai / openrouter / litellm 等；
#   任意 OpenAI 兼容端点填 openai，再配下面的 BASE_URL。
HINDSIGHT_API_LLM_PROVIDER=openai

# 这是唯一有意「不注释、留空」的键：它属于字符串类，留空只会让容器报出
# 「缺 LLM API key」这条明确错误，正是我们要的提示。
HINDSIGHT_API_LLM_API_KEY=

# 不填则用 Hindsight 为该 provider 预设的默认模型（openai 是 gpt-5-mini）。
# 注意：这张预设表由 Hindsight 自己维护，不是各家官方默认值；表外的冷门
# provider 会静默回落成 gpt-4o-mini 并把这个模型名发给你的端点。
# 用中转站 / 自建端点时，务必显式写出该端点真实存在的模型名。
#HINDSIGHT_API_LLM_MODEL=

# 仅 OpenAI 兼容端点（中转站 / Azure / vLLM / Ollama / LM Studio）需要，
# 必须指向暴露 /chat/completions 的那一层，通常以 /v1 结尾
#HINDSIGHT_API_LLM_BASE_URL=https://your-endpoint.example.com/v1

# 仅当模型输出 token 上限低于 65000 时需要，取值须大于 3000（chunk 大小）
#HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=32000

# ============ 控制台 UI（http://127.0.0.1:9999）============
# 不填则 UI 无登录口令，任何能访问该端口的人都能读写全部记忆。
# 端口只绑回环，所以风险限于本机上的其他进程。
#HINDSIGHT_CP_ACCESS_KEY=

# ============ 启动初始化超时（一般不用改）============
# 这个超时覆盖启动期的 embedding 加载、cross-encoder 加载和 **LLM 连通性校验**。
# 实际最常见的卡点是 LLM 连通性校验（端点不可达、base_url 写错、被限流），
# 而不是模型下载——完整镜像已预置默认 embedding / reranker 模型，冷启动约 15s。
# 所以端点连不上时，正确做法是修 BASE_URL，而不是把这个超时调大。
#
# 调大它时必须同步把 docker-compose.yml 里 hindsight 的 healthcheck.start_period
# 改成「本值 + 30s」以上，否则 healthcheck 会早于容器自身超时判定 unhealthy。
#HINDSIGHT_API_MODEL_INIT_TIMEOUT=900

# ============ HuggingFace 下载源（一般不用改）============
# hf-mirror.com 是第三方社区镜像站（非 HuggingFace 官方），会把模型下载流量
# 导向该第三方。仅在你改用非默认的本地 embedding / reranker 模型、需要真正
# 联网下载时才有意义；默认配置下不产生下载动作，设了也不生效。
#HF_ENDPOINT=https://hf-mirror.com
