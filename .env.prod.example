# 远程服务器部署用的环境变量模板（第一步：先跑通，不含域名/证书）
#
# 用法：复制成 .env.prod，填好「必填」项，然后
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ============================================================
# 一条规则：不需要的项保持注释状态，**不要写成 KEY= 留空**。
#
# 留空会往容器里注入空字符串，而 Hindsight 各处读环境变量的写法不统一，
# 后果不一样，且都不好查：
#   - HINDSIGHT_API_LLM_PROVIDER：空串覆盖默认值 openai，得到非法的空 provider
#   - HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL：空串直接生效，不回落默认，
#     embedding 调用失败
#   - HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS：空串不报错，静默变成「不传
#     dimensions 参数」，也就是用模型原生维度，而维度会写进数据库 schema
#   - HINDSIGHT_API_MODEL_INIT_TIMEOUT：空串让容器在 float() 解析时直接崩溃退出
#
# 带 :? 保护的变量漏填时 compose 会报错拒绝启动，不会静默跑起来。
# ============================================================

# ============ dsh 对外认证（必填）============
# dsh 是能执行任意命令的 coding agent，第一步里端口直接对外发布，
# 这是唯一一道门。两个都必须设，任一缺失代理层会完全放行。
#   生成密码：openssl rand -base64 24
PROXY_USERNAME=
PROXY_PASSWORD=

# ============ Hindsight 鉴权（必填）============
# 服务端 API token，dsh 和控制台共用。不要沿用本机的 123456。
#   生成：openssl rand -hex 32
HINDSIGHT_API_TOKEN=

# 控制台 UI 的登录口令。控制台只绑回环、走 SSH 隧道访问，但服务器本机上
# 任何进程都能碰到 9999，所以还是设一个。
#   生成：openssl rand -base64 24
HINDSIGHT_CP_ACCESS_KEY=

# ============ 域名与证书（仅 Caddy 方案需要）============
# 只有叠加 docker-compose.caddy.yml 时才用到这两项，那种情况下它们是必填的。
# 宿主上已经有 Nginx 占着 80/443 的话走 Nginx 反代（见
# config/nginx-dsh.conf.example），域名写在 Nginx 的 server 块里，
# 这两行保持注释即可。
#
# 用 Caddy 方案前先确认三件事，缺任何一件签发都会失败：
#   1. dig +short <域名>  的结果等于  curl -s ifconfig.me
#   2. 云控制台安全组放通 TCP 80 和 443（80 用于 ACME HTTP-01 挑战，不能省）
#   3. systemctl is-active firewalld  若是 active，也要放通 80/443
#
# 不要带 https:// 前缀，也不要带路径或端口，只写主机名。
#DSH_DOMAIN=dsh.example.com
# 证书即将到期或签发异常时 Let's Encrypt 会发信到这里。写一个你真会看的邮箱。
#ACME_EMAIL=you@example.com

# ============ 数据目录（必填）============
# 所有需要持久化的数据都放在这个目录下的子目录里，方便整体备份和换盘：
#   hindsight-data/   Hindsight 的 pg0 数据库（记忆本体，最该备份）
#   dsh-home/         会话历史、已装插件、profile、.credentials.yaml
#   hindsight-agent/  coding-agents 插件的运行时状态
#   caddy-data/       TLS 证书与 ACME 账号私钥
#   caddy-config/     Caddy 自动保存的运行配置
#
# 必须是绝对路径。有独立数据盘就指到盘上（云服务器的系统盘通常又小又不好扩）。
#
# 首次启动前必须先建目录并设好属主，否则 hindsight 起不来——
# 具体命令见 docker-compose.prod.yml 顶部注释，关键是
# hindsight-data 要 chown 1000:1000（容器内那个用户的 uid）。
DATA_DIR=/data/dsh

# ============ 代码目录（必填）============# 宿主上要让 dsh 操作的目录，会挂到容器内 /workspace。
# 必须是绝对路径。相对路径会以 compose 文件所在目录为基准，写错了 Docker 会
# 默默创建一个 root 属主的空目录，不会报错。
WORKSPACE_DIR=/home/youruser/code

# ============ LLM：DeepSeek 直连（必填）============
# provider 内置了正确的 base_url（https://api.deepseek.com），**不要**再填
# HINDSIGHT_API_LLM_BASE_URL，填了反而容易写错。
# 模型可选：
#   deepseek-chat      非思考别名，更快更便宜 —— 事实抽取这种高频调用推荐用它
#   deepseek-v4-flash  默认思考模式（API 层等同 deepseek-reasoner），Hindsight 会透明处理
#   deepseek-v4-pro    质量更高的推理路线，贵
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=deepseek-chat

# ============ Embedding：硅基流动（必填，slim 镜像不带本地模型）============
# 官网当前 BAAI/bge-m3 免费。撞限流的话把模型名换成 Pro/BAAI/bge-m3
# （¥0.07/百万 token），同一个模型、同样 1024 维，切换不需要重新 embed。
# 这里的 key 不能留空吃回落了 —— LLM key 已经换成 DeepSeek 的，回落过去会 401。
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=BAAI/bge-m3

# ！！下面这行必须保持注释 ！！
# bge-m3 输出维度固定 1024，不支持 OpenAI 的 dimensions 参数。设了大概率报错，
# 不报错也会把错的维度写进数据库 schema。维度一旦落库，改动就要把所有已有记忆
# 重新 embed，所以第一次 up 之前就得是对的。
#HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=

# 一次请求塞多少条输入，默认 100。免费档速率限制较严，报 429 或超时就往下调
# （Hindsight 文档里举的 DashScope 例子只允许 10，这类上游限制很常见）。
#HINDSIGHT_API_EMBEDDINGS_OPENAI_BATCH_SIZE=20

# ============ Reranker：硅基流动（必填）============
# 官网当前 BAAI/bge-reranker-v2-m3 免费。跑在对方服务器上，本地零内存开销，
# 却拿到了真正的交叉编码器重排。key 和上面 embedding 用同一个。
HINDSIGHT_API_RERANKER_SILICONFLOW_API_KEY=
# 不填则用默认的 BAAI/bge-reranker-v2-m3；撞限流时换 Pro/BAAI/bge-reranker-v2-m3
#HINDSIGHT_API_RERANKER_SILICONFLOW_MODEL=BAAI/bge-reranker-v2-m3

# ============ 数据库（可选）============
# 不填则用内嵌 pg0（已实测 slim + pg0 可正常启动）。
# pg0 会随记忆量和索引增长，且容器被 OOM 杀掉时可能损坏；等记忆攒多了
# 或者内存吃紧时再换外部 Postgres（需 pgvector 扩展），Neon / Supabase 免费档够用。
#HINDSIGHT_API_DATABASE_URL=postgresql://user:pass@host:5432/hindsight?sslmode=require

# ============ 启动超时（一般不用改）============
#HINDSIGHT_API_MODEL_INIT_TIMEOUT=900

# ============ 历史会话的工作目录（可选）============
# 只有一种情况需要设：Web UI 里某个工作区下的会话突然全跑到「未分组」去了。
#
# 原因是工作区分组在读取时会重新校验「会话 cwd 逐字等于工作区 path」，而容器
# 重建（换镜像必然重建）会丢掉可写层 —— 工作目录不在挂载点下就消失了，校验
# 失败，那个工作区就变成空的。会话历史本身在 dsh-home 里，一条都没丢。
#
# 取值：从 $DATA_DIR/dsh-home/storages/workspace.json 里把 path 字段抄出来，
# 必须逐字一致。比如
#   sudo grep -oE '"(path|title)": *"[^"]*"' $DATA_DIR/dsh-home/storages/workspace.json
# 宿主侧固定挂 $DATA_DIR/session-workdir，改这个变量只改容器内的落点。
#
# 挂载只恢复分组，不恢复那个目录里原有的文件（随旧容器一起没了）。
# 长远做法是以后都在 /workspace 下开会话，那个路径本来就是挂载的。
#SESSION_WORKDIR=/root/weirwei

# ============ dsh 镜像版本（可选）============
# dsh 和 dsh-init 两个服务共用这一个值，必须一致 —— 插件是在 dsh-init 里按
# 当时的宿主解析依赖装进 profile 的，两边版本错开装出来的插件加载会失败，
# 报的是「client-modules: boot manifest ... must be an array」这类形状错误。
#
# 不填则用 compose 里钉住的版本。故意不用 latest：一次 pull 会同时换掉 dsh
# 本体、镜像内那层 node 代理、以及宿主对插件的 ABI 要求，三者不同步时症状
# 各不相同且都不好查（README「升级」一节有实例）。
#
# 可用 tag：https://hub.docker.com/r/smanx/deepseek-harness/tags
#DSH_IMAGE=smanx/deepseek-harness:0.1.5-rc.2

# ============ 插件预装（可选）============
# dsh-init 服务会在 dsh 启动前把这里列出的插件装进 profile web。
# 空格分隔，pnpm spec 语法，可带 @版本。
#
# 不填则用 compose 里的默认值，也就是这两个：
#   dshmarket                              插件市场，装完其余 3000+ 插件在
#                                          「设置 → 插件市场」里点一下就行
#   @vectorize-io/hindsight-coding-agents  接本栈自带的 hindsight 长期记忆
#
# 只有在你要增删插件时才需要解开这一行，注意解开后就是完整覆盖，
# 想保留上面两个默认插件必须把它们一并写进来。
#
# 已装的插件会被跳过，所以每次 up 不会白等一轮网络请求。
# 安装失败不会阻塞 dsh 启动，只是插件没装上；修好网络后重跑：
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d dsh-init
#DSH_PLUGINS=dshmarket @vectorize-io/hindsight-coding-agents

# 换 npm 源。国内机器走 registry.npmjs.org 经常 10s+ 甚至超时（实测一次
# dshmarket 元数据请求就花了 15s）。两个都要设：corepack 下载 pnpm 自己的
# 二进制走前者，pnpm 装插件走后者。
# 按本文件顶部那条规则，不需要就保持注释，别写成 KEY= 留空。
#COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
#npm_config_registry=https://registry.npmmirror.com
